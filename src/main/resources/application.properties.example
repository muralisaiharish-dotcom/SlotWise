# SlotWise Application Configuration
# ====================================
# Copy this file to application.properties and fill in your
# actual database credentials. NEVER commit the real file to Git.

# MySQL Database Connection
db.url=jdbc:mysql://localhost:3306/slotwise_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
db.username=YOUR_MYSQL_USERNAME
db.password=YOUR_MYSQL_PASSWORD

# Connection Pool Settings
db.pool.maxSize=10
